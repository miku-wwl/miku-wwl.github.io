---
import MvpBadge from './MvpBadge.astro';
import { SITE_TITLE } from '../consts';

const showTrustMarks = Astro.url.pathname === '/';
---

<header class="site-header">
	<div class="bar">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} — Home`}>
			<span class="brand-prompt" aria-hidden="true">~/miku-wwl</span>
			<span class="brand-sep" aria-hidden="true">$</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<MvpBadge variant="inline" />

		{showTrustMarks && (
			<div class="trust-marks" aria-label="Professional and national marks">
				<a class="trust-mark" href="https://miku-wwl.github.io/certification-vault/" aria-label="HashiCorp Certified Terraform Authoring and Operations Professional" title="HashiCorp Certified: Terraform Authoring and Operations Professional">
					<img src="/certifications/terraform-authoring-operations-professional.png" alt="Terraform Professional" loading="eager" decoding="async" />
				</a>
				<a class="trust-mark" href="https://miku-wwl.github.io/certification-vault/" aria-label="Microsoft Certified Azure Solutions Architect Expert" title="Microsoft Certified: Azure Solutions Architect Expert">
					<img src="/certifications/azure-solutions-architect-expert.png" alt="Azure Solutions Architect Expert" loading="eager" decoding="async" />
				</a>
				<a class="trust-mark" href="https://miku-wwl.github.io/certification-vault/" aria-label="AWS Certified Solutions Architect Professional" title="AWS Certified Solutions Architect Professional">
					<img src="/certifications/aws-solutions-architect-professional.png" alt="AWS Solutions Architect Professional" loading="eager" decoding="async" />
				</a>
				<a class="trust-mark" href="https://miku-wwl.github.io/certification-vault/" aria-label="Certified Kubernetes Application Developer" title="Certified Kubernetes Application Developer">
					<img src="/certifications/ckad.png" alt="Certified Kubernetes Application Developer" loading="eager" decoding="async" />
				</a>
				<span class="trust-mark trust-mark-kiwi" role="img" aria-label="Kiwi bird mark" title="Kiwi bird">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M3.5 15.2c2.4-2.1 5.2-3.1 8.3-2.8 1.5.1 2.8.6 4 1.2l5-4.1c.5-.4 1.2.2.8.8l-3.6 5.2c-1.2 2.8-3.7 4.7-6.8 4.9-2.9.2-6-1.2-7.5-3.2-.6-.8-.7-1.4-.2-2Z" fill="currentColor" />
						<path d="M15.4 14.1 21.7 9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.2" />
						<circle cx="13.8" cy="14.9" r=".8" fill="var(--bg)" />
					</svg>
				</span>
				<span class="trust-mark trust-mark-star" role="img" aria-label="Australian Commonwealth Star" title="Australian Commonwealth Star">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m12 2.8 1.8 6 5.7-2.2-3.2 5.2 5.1 3.4-6 .2-.5 6-3-5.2-5.1 3.2 2.1-5.7-5.7-1.8 6-.9L8.8 5l4.1 3.8L12 2.8Z" fill="currentColor" />
					</svg>
				</span>
			</div>
		)}

		<nav class="module-nav" aria-label="Portfolio modules">
			<a class="module-nav-link is-active" href="https://miku-wwl.github.io/" aria-current="page">hub</a>
			<a class="module-nav-link" href="https://miku-wwl.github.io/career-journey/">career</a>
			<a class="module-nav-link" href="https://miku-wwl.github.io/engineering-projects/">projects</a>
			<a class="module-nav-link" href="https://miku-wwl.github.io/certification-vault/">certs</a>
			<a class="module-nav-link" href="https://miku-wwl.github.io/engineering-lab/">lab</a>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var root = document.documentElement;

		root.setAttribute('data-theme', 'dark');
		try { localStorage.setItem('theme', 'dark'); } catch (_) {}
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: saturate(140%) blur(10px);
		-webkit-backdrop-filter: saturate(140%) blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: var(--max-page);
		margin: 0 auto;
		padding: 0.7rem 1.25rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-mono);
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.brand:hover { text-decoration: none; }
	.brand-prompt { color: var(--accent); }
	.brand-sep { color: var(--prompt); }
	.brand-name { color: var(--text); font-weight: 700; }
	.trust-marks {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.42rem;
		flex: 1 1 auto;
		min-width: 0;
		margin-inline: clamp(0.25rem, 1.5vw, 1.25rem);
		padding: 0.1rem 0.25rem;
	}
	.trust-mark {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		flex: 0 0 auto;
		border: 1px solid color-mix(in srgb, var(--border) 78%, var(--prompt));
		border-radius: 0.5rem;
		background: rgba(4, 15, 27, 0.78);
		box-shadow: 0 0 14px rgba(40, 198, 255, 0.08);
		transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
	}
	.trust-mark:hover {
		transform: translateY(-1px);
		border-color: var(--prompt);
		box-shadow: 0 0 16px var(--award-soft);
	}
	.trust-mark img { width: 1.7rem; height: 1.7rem; object-fit: contain; }
	.trust-mark svg { width: 1.45rem; height: 1.45rem; }
	.trust-mark-kiwi { color: #57e1ae; }
	.trust-mark-star { color: #ffc14d; }
	.module-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: auto;
		max-width: 100%;
		overflow-x: auto;
		padding: 0.15rem;
		scrollbar-width: none;
	}
	.module-nav::-webkit-scrollbar { display: none; }
	.module-nav-link {
		flex: 0 0 auto;
		padding: 0.42rem 0.62rem;
		border: 1px solid transparent;
		border-radius: 0.45rem;
		color: var(--text-muted);
		font: 0.68rem var(--font-mono);
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
	}
	.module-nav-link:hover,
	.module-nav-link.is-active {
		border-color: var(--border);
		background: var(--surface-2);
		color: var(--text);
	}
	.module-nav-link.is-active::before { content: '› '; color: var(--accent); }

	@media (max-width: 480px) {
		.bar { gap: 0.55rem; }
		.brand-prompt { display: none; }
		.trust-marks { order: 3; width: 100%; justify-content: flex-start; margin-inline: 0; overflow-x: auto; }
		.module-nav { width: 100%; margin-left: 0; order: 4; }
	}
</style>
