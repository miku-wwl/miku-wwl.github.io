---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const modules = [
	{
		id: '01',
		title: 'Career Journey',
		slug: 'career-journey',
		href: 'https://miku-wwl.github.io/career-journey/',
		command: './open career-journey',
		copy: 'Trace roles, systems, and learning checkpoints across the engineering path.',
		meta: 'experience · education · trajectory',
		accent: 'green',
		icon: '⌁',
	},
	{
		id: '02',
		title: 'Engineering Projects',
		slug: 'engineering-projects',
		href: 'https://miku-wwl.github.io/engineering-projects/',
		command: './open engineering-projects',
		copy: 'Explore active and planned work across backend platforms, cloud governance, and SRE.',
		meta: 'systems · platform · reliability',
		accent: 'cyan',
		icon: '◈',
	},
	{
		id: '03',
		title: 'Certification Vault',
		slug: 'certification-vault',
		href: 'https://miku-wwl.github.io/certification-vault/',
		command: './open certification-vault',
		copy: 'Open the verified credential archive for cloud, Kubernetes, and platform engineering.',
		meta: 'azure · aws · kubernetes',
		accent: 'violet',
		icon: '◇',
	},
	{
		id: '04',
		title: 'Engineering Lab',
		slug: 'engineering-lab',
		href: 'https://miku-wwl.github.io/engineering-lab/',
		command: './open engineering-lab',
		copy: 'Enter the playground for interactive demos, games, experiments, and prototypes.',
		meta: 'experiments · demos · play',
		accent: 'amber',
		icon: '✦',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="hub-splash" aria-hidden="true">
			<video class="hub-splash-video" autoplay muted playsinline preload="auto">
				<source src="/videos/openvideo.mp4" type="video/mp4" />
			</video>
			<div class="hub-splash-shade"></div>
			<div class="hub-splash-panel hub-splash-panel-left"></div>
			<div class="hub-splash-panel hub-splash-panel-right"></div>
			<div class="hub-splash-copy">
				<p class="hub-splash-kicker mono">~/miku-wwl $ boot --hub</p>
				<strong>PORTAL ONLINE</strong>
				<span class="hub-splash-status mono"><span class="status-dot"></span> opening interface</span>
			</div>
		</div>
		<script is:inline>
			(() => {
				const splash = document.querySelector('.hub-splash');
				const video = splash?.querySelector('.hub-splash-video');
				if (!splash || !video) return;

				let revealed = false;
				const reveal = () => {
					if (revealed) return;
					revealed = true;
					video.pause();
					splash.classList.add('is-opening');
				};

				video.addEventListener('timeupdate', () => {
					if (video.currentTime >= 2.5) reveal();
				});
				video.addEventListener('ended', reveal, { once: true });
				video.addEventListener('error', reveal, { once: true });
				window.setTimeout(reveal, 3100);
				const playback = video.play();
				if (playback?.catch) playback.catch(reveal);
			})();
		</script>
		<div class="hub-page-background" aria-hidden="true"></div>
		<Header />
		<aside class="module-rail" aria-label="Portfolio module navigation">
			<span class="module-rail-tab" aria-hidden="true">≡</span>
			<p class="module-rail-kicker">MODULES</p>
			<a class="module-rail-link is-active" href="https://miku-wwl.github.io/" aria-current="page"><span>01</span><strong>HUB</strong></a>
			<a class="module-rail-link" href="https://miku-wwl.github.io/career-journey/"><span>02</span><strong>CAREER</strong></a>
			<a class="module-rail-link" href="https://miku-wwl.github.io/engineering-projects/"><span>03</span><strong>PROJECTS</strong></a>
			<a class="module-rail-link" href="https://miku-wwl.github.io/certification-vault/"><span>04</span><strong>CERTS</strong></a>
			<a class="module-rail-link" href="https://miku-wwl.github.io/engineering-lab/"><span>05</span><strong>LAB</strong></a>
		</aside>
		<main class="hub-main">
			<section class="hub-hero" aria-labelledby="hub-title">
				<div class="hub-copy">
					<p class="eyebrow">~/miku-wwl $ whoami</p>
					<h1 id="hub-title">Weilai Wang</h1>
					<p class="hub-tagline mono">{SITE_TAGLINE}</p>
					<p class="hub-bio">Auckland-based software engineer building backend systems, cloud-native platforms, and reliable paths through complex technical problems.</p>
					<div class="hub-signal"><span class="status-dot" aria-hidden="true"></span><span class="mono">portal online · choose a destination to continue</span></div>
				</div>

				<div class="hub-visual">
					<div class="scene-label scene-label-top">// STATUS :: HUB</div>
					<div class="scene-label scene-label-bottom">ORBITAL INDEX / 04 NODES</div>
				</div>

				<aside class="hud-panel hub-hud" aria-label="Hub status">
					<p class="hud-title">// SYSTEM HUD</p>
					<div class="hud-row"><span>status</span><strong class="live"><span class="status-dot" aria-hidden="true"></span> ONLINE</strong></div>
					<div class="hud-row"><span>nodes</span><strong>04</strong></div>
					<div class="hud-row"><span>mode</span><strong class="cyan">explore</strong></div>
					<div class="hud-row"><span>theme</span><strong>night-only</strong></div>
					<div class="hud-time mono"><span>local time</span><strong data-live-time>--:--:--</strong></div>
				</aside>
			</section>

			<section class="launcher-section" aria-labelledby="launcher-title">
				<div class="launcher-heading">
					<div>
						<p class="eyebrow">~/miku-wwl $ select --module</p>
						<h2 id="launcher-title">Choose your next area</h2>
					</div>
					<p class="launcher-hint mono">4 destinations · independent pages</p>
				</div>
				<nav class="module-grid" aria-label="Portfolio destinations">
					{modules.map((module) => (
						<a class:list={['module-card', module.accent]} href={module.href} data-module={module.slug}>
							<span class="module-glow" aria-hidden="true"></span>
							<span class="module-topline"><span class="module-id">NODE_{module.id}</span><span class="module-status"><span class="status-dot" aria-hidden="true"></span>READY</span></span>
							<span class="module-icon" aria-hidden="true">{module.icon}</span>
							<span class="module-title-row"><span class="module-title">{module.title}</span><span class="module-arrow" aria-hidden="true">↗</span></span>
							<span class="module-command mono">{module.command}</span>
							<span class="module-copy">{module.copy}</span>
							<span class="module-meta mono">{module.meta}</span>
						</a>
					))}
				</nav>
			</section>

			<section class="legacy-section" aria-labelledby="legacy-title">
				<div class="legacy-window">
					<div class="legacy-bar"><span class="terminal-dots" aria-hidden="true"><span class="terminal-dot red"></span><span class="terminal-dot yellow"></span><span class="terminal-dot green"></span></span><span>legacy-routes.txt</span></div>
					<div class="legacy-body">
						<div><p class="eyebrow">~/miku-wwl $ cat legacy-routes.txt</p><h2 id="legacy-title">The original Astro routes remain online</h2></div>
						<nav class="legacy-links" aria-label="Original portfolio routes"><a href="/about">about <span>→</span></a><a href="/blog">blog <span>→</span></a><a href="/experience">experience <span>→</span></a><a href="/projects">projects <span>→</span></a><a href="/certifications">certifications <span>→</span></a></nav>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { position: relative; }
	.hub-splash { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; pointer-events: none; }
	.hub-splash-video, .hub-splash-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
	.hub-splash-video { z-index: 0; object-fit: cover; object-position: center; background: #02080e; }
	.hub-splash-shade { z-index: 1; background: radial-gradient(circle at center, rgba(3, 10, 18, 0.02), rgba(2, 8, 14, 0.22)); }
	.hub-splash-panel { position: relative; z-index: 2; min-width: 0; background: linear-gradient(145deg, rgba(6, 19, 31, 0.16), rgba(2, 8, 14, 0.34) 72%); }
	.hub-splash-panel::after { position: absolute; top: 0; bottom: 0; width: 1px; content: ''; background: linear-gradient(transparent, var(--prompt), transparent); opacity: 0.75; }
	.hub-splash-panel-left { transform-origin: left center; border-right: 1px solid rgba(40, 240, 160, 0.24); }
	.hub-splash-panel-left::after { right: 0; }
	.hub-splash-panel-right { transform-origin: right center; border-left: 1px solid rgba(40, 240, 160, 0.24); }
	.hub-splash-panel-right::after { left: 0; }
	.hub-splash.is-opening { animation: hub-splash-dismiss 320ms ease 1.1s forwards; }
	.hub-splash.is-opening .hub-splash-panel-left { animation: hub-splash-open-left 1.1s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
	.hub-splash.is-opening .hub-splash-panel-right { animation: hub-splash-open-right 1.1s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
	.hub-splash-copy { position: absolute; inset: 0; z-index: 3; display: grid; place-content: center; justify-items: center; gap: 0.45rem; color: var(--text); text-align: center; }
	.hub-splash.is-opening .hub-splash-copy { animation: hub-splash-copy-exit 420ms ease forwards; }
	.hub-splash-kicker { margin: 0; color: var(--accent); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
	.hub-splash-copy strong { color: var(--prompt); font: 700 clamp(1.35rem, 3vw, 2.5rem) var(--font-mono); letter-spacing: 0.12em; }
	.hub-splash-status { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--text-muted); font-size: 0.68rem; letter-spacing: 0.08em; }
	@keyframes hub-splash-open-left { to { transform: translateX(-100%); } }
	@keyframes hub-splash-open-right { to { transform: translateX(100%); } }
	@keyframes hub-splash-copy-exit { to { opacity: 0; transform: scale(0.96); } }
	@keyframes hub-splash-dismiss { to { visibility: hidden; opacity: 0; } }
	.hub-page-background { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: url('/images/portfolio-backgrounds/01-main-hub-bg.png') center top / cover no-repeat; }
	:global(body > header), :global(body > main), :global(body > footer) { position: relative; z-index: 1; }
	.module-rail { --rail-accent: var(--prompt); position: fixed; top: 50%; left: 0; z-index: 20; display: grid; width: 8.2rem; gap: 0.25rem; padding: 0.55rem; transform: translate(calc(-100% + 0.72rem), -50%); border: 1px solid color-mix(in srgb, var(--rail-accent) 42%, var(--border)); border-radius: 0 var(--radius) var(--radius) 0; background: color-mix(in srgb, var(--surface) 88%, transparent); box-shadow: var(--shadow-2); backdrop-filter: blur(16px) saturate(130%); transition: transform 180ms ease; }
	.module-rail:hover, .module-rail:focus-within { transform: translate(0, -50%); }
	.module-rail-tab { position: absolute; top: 50%; right: 0; display: grid; place-items: center; width: 0.72rem; height: 3.2rem; transform: translateY(-50%); border-left: 1px solid color-mix(in srgb, var(--rail-accent) 42%, var(--border)); border-radius: var(--radius-sm) 0 0 var(--radius-sm); color: var(--rail-accent); background: color-mix(in srgb, var(--rail-accent) 10%, var(--surface)); font: 700 0.95rem var(--font-mono); }
	.module-rail-kicker { margin: 0 0 0.25rem; padding: 0.2rem 0.42rem 0.35rem; border-bottom: 1px dashed var(--border); color: var(--text-faint); font: 0.57rem var(--font-mono); letter-spacing: 0.12em; }
	.module-rail-link { display: flex; align-items: center; gap: 0.5rem; min-height: 2.05rem; padding: 0.4rem 0.45rem; border: 1px solid transparent; border-radius: var(--radius-sm); color: var(--text-muted); text-decoration: none; transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease; }
	.module-rail-link span { color: var(--text-faint); font: 0.58rem var(--font-mono); }
	.module-rail-link strong { font: 600 0.62rem var(--font-mono); letter-spacing: 0.08em; }
	.module-rail-link:hover, .module-rail-link.is-active { border-color: color-mix(in srgb, var(--rail-accent) 55%, var(--border)); background: color-mix(in srgb, var(--rail-accent) 11%, var(--surface)); color: var(--text); text-decoration: none; transform: translateX(2px); }
	.module-rail-link.is-active::before { content: '›'; color: var(--rail-accent); font: 700 0.95rem var(--font-mono); }
	.module-rail-link.is-active span, .module-rail-link.is-active strong { color: var(--rail-accent); }
	.hub-main { max-width: 1380px; }
	.hub-hero { display: grid; grid-template-columns: minmax(250px, 0.82fr) minmax(390px, 1.38fr) 210px; gap: 1.15rem; align-items: stretch; min-height: 370px; margin-top: 0.4rem; }
	.hub-copy { display: flex; flex-direction: column; justify-content: center; padding: 1rem 0.2rem; }
	.hub-copy h1 { margin: 0.2rem 0 0.6rem; font-size: clamp(2.35rem, 3.5vw, 3.9rem); white-space: nowrap; }
	.hub-tagline { max-width: 42ch; margin: 0 0 1rem; color: var(--prompt); font-size: 0.84rem; line-height: 1.55; }
	.hub-bio { max-width: 46ch; margin: 0; color: var(--text-muted); font-size: 0.93rem; }
	.hub-signal { display: flex; align-items: center; gap: 0.55rem; margin-top: 1.5rem; padding-top: 0.75rem; border-top: 1px dashed var(--border); color: var(--text-muted); font-size: 0.68rem; }
	.status-dot { display: inline-block; flex: 0 0 auto; width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--prompt); box-shadow: 0 0 10px color-mix(in srgb, var(--prompt) 75%, transparent); }
	.hub-visual { position: relative; height: 370px; }
	.scene-label { position: absolute; z-index: 4; color: var(--cyan); font: 0.62rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; pointer-events: none; }
	.scene-label-top { top: 0.75rem; left: 1rem; }
	.scene-label-bottom { right: 1rem; bottom: 0.75rem; color: var(--text-faint); }
	.hud-panel { min-width: 0; align-self: center; padding: 1.05rem 1rem 0.9rem; border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--border)); border-radius: var(--radius-lg); background: linear-gradient(155deg, color-mix(in srgb, var(--surface-2) 92%, transparent), color-mix(in srgb, var(--surface) 78%, transparent)); box-shadow: var(--shadow-1), inset 0 1px 0 rgba(255, 255, 255, 0.04); backdrop-filter: blur(14px) saturate(125%); }
	.hud-title { margin: 0 0 0.7rem; color: var(--text); font: 600 0.78rem var(--font-mono); letter-spacing: 0.08em; }
	.hud-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; padding: 0.58rem 0; border-bottom: 1px solid color-mix(in srgb, var(--border) 78%, transparent); }
	.hud-row > span { min-width: 0; color: var(--text-muted); font: 0.65rem var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
	.hud-row > strong { min-width: 0; color: var(--text); font: 600 0.72rem var(--font-mono); text-align: right; overflow-wrap: anywhere; }
	.hud-row > strong.live { display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.38rem; color: var(--prompt); }
	.hud-row > strong.cyan { color: var(--accent); }
	.hub-hud { align-self: center; }
	.hud-time { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.6rem; padding-top: 0.65rem; border-top: 1px dashed var(--border); color: var(--text-faint); font-size: 0.66rem; }
	.hud-time strong { color: var(--text-muted); font-weight: 500; }
	.launcher-section { margin-top: 2.25rem; }
	.launcher-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 0.85rem; }
	.launcher-heading h2 { margin-bottom: 0; }
	.launcher-hint { margin: 0; color: var(--text-muted); font-size: 0.7rem; }
	.module-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
	.module-card { position: relative; display: flex; flex-direction: column; min-height: 260px; overflow: hidden; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: linear-gradient(160deg, rgba(8, 22, 35, 0.92), rgba(3, 11, 19, 0.86)); color: var(--text); text-decoration: none; box-shadow: var(--shadow-1); transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease; }
	.module-card:hover { color: var(--text); text-decoration: none; transform: translateY(-5px); border-color: var(--module-color); background: linear-gradient(160deg, color-mix(in srgb, var(--module-color) 10%, var(--surface)), rgba(3, 11, 19, 0.92)); box-shadow: 0 0 0 1px var(--module-color), 0 18px 40px color-mix(in srgb, var(--module-color) 18%, transparent); }
	.module-card:focus-visible { box-shadow: var(--ring), 0 18px 40px color-mix(in srgb, var(--module-color) 18%, transparent); }
	.module-card.green { --module-color: var(--prompt); }
	.module-card.cyan { --module-color: var(--accent); }
	.module-card.violet { --module-color: var(--magenta); }
	.module-card.amber { --module-color: var(--yellow); }
	.module-glow { position: absolute; width: 180px; height: 180px; top: -92px; right: -55px; border-radius: 50%; background: var(--module-color); opacity: 0.08; filter: blur(10px); transition: opacity 180ms ease, transform 180ms ease; }
	.module-card:hover .module-glow { opacity: 0.2; transform: scale(1.3); }
	.module-topline, .module-title-row { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; }
	.module-topline { margin-bottom: 1.35rem; color: var(--text-faint); font-size: 0.62rem; }
	.module-id, .module-status { font-family: var(--font-mono); letter-spacing: 0.08em; }
	.module-status { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--module-color); }
	.module-status .status-dot { width: 5px; height: 5px; box-shadow: 0 0 8px var(--module-color); background: var(--module-color); }
	.module-icon { position: relative; z-index: 1; display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 0.9rem; border: 1px solid color-mix(in srgb, var(--module-color) 50%, var(--border)); border-radius: var(--radius); color: var(--module-color); background: color-mix(in srgb, var(--module-color) 8%, var(--surface)); font: 1.6rem var(--font-mono); }
	.module-title-row { align-items: baseline; }
	.module-title { font: 600 clamp(0.95rem, 1vw, 1.15rem)/1.25 var(--font-mono); }
	.module-arrow { color: var(--module-color); font: 700 1.3rem var(--font-mono); transition: transform 180ms ease; }
	.module-card:hover .module-arrow { transform: translate(3px, -3px); }
	.module-command { margin: 0.6rem 0 0.75rem; color: var(--module-color); font-size: 0.66rem; }
	.module-copy { color: var(--text-muted); font-size: 0.78rem; line-height: 1.55; }
	.module-meta { margin-top: auto; padding-top: 1rem; color: var(--text-faint); font-size: 0.61rem; }
	.legacy-section { margin-top: 1.75rem; }
	.legacy-window { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
	.legacy-bar { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.8rem; border-bottom: 1px solid var(--border); background: var(--surface-2); color: var(--text-muted); font: 0.7rem var(--font-mono); }
	.legacy-body { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; padding: 0.95rem 1.1rem 1rem; }
	.legacy-body h2 { margin: 0; font-size: 0.95rem; }
	.legacy-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem; }
	.legacy-links a { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.55rem; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-muted); font: 0.66rem var(--font-mono); text-decoration: none; transition: color 120ms ease, border-color 120ms ease, transform 120ms ease; }
	.legacy-links a:hover { border-color: var(--accent); color: var(--text); text-decoration: none; transform: translateY(-1px); }
	.legacy-links span { color: var(--accent); }
	@media (max-width: 1100px) { .module-rail { top: 4.6rem; left: 50%; width: min(1380px, calc(100% - 2rem)); margin: 0; transform: translate(-50%, calc(-100% + 0.72rem)); grid-template-columns: auto repeat(5, minmax(0, 1fr)); align-items: center; border-radius: 0 0 var(--radius) var(--radius); } .module-rail:hover, .module-rail:focus-within { transform: translate(-50%, 0); } .module-rail-tab { top: auto; right: 50%; bottom: 0; width: 3.2rem; height: 0.72rem; transform: translateX(50%); border-top: 1px solid color-mix(in srgb, var(--rail-accent) 42%, var(--border)); border-left: 0; border-radius: 0 0 var(--radius-sm) var(--radius-sm); } .module-rail-kicker { margin: 0; border-bottom: 0; } .module-rail-link { justify-content: center; } .hub-hero { grid-template-columns: minmax(230px, 0.85fr) minmax(330px, 1.15fr); } .hub-hud { grid-column: 1 / -1; } .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 680px) { .hub-page-background { background-size: auto 100%; background-position: 58% top; } .module-rail { width: calc(100% - 1rem); display: flex; gap: 0.35rem; overflow-x: auto; padding: 0.4rem; } .module-rail-kicker { flex: 0 0 auto; padding: 0.4rem 0.35rem; } .module-rail-link { flex: 0 0 auto; justify-content: flex-start; } .hub-hero { grid-template-columns: 1fr; min-height: auto; } .hub-copy { padding-top: 0; } .hub-copy h1 { white-space: normal; } .hub-visual { height: 290px; } .hub-hud { grid-column: auto; } .hud-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } .hud-row > strong { text-align: right; } .module-grid { grid-template-columns: 1fr; } .module-card { min-height: 245px; } .launcher-heading, .legacy-body { display: block; } .launcher-hint { margin-top: 0.4rem; } .legacy-links { justify-content: flex-start; margin-top: 0.9rem; } }
	@media (prefers-reduced-motion: reduce) { .hub-splash { display: none; } .module-rail, .module-card, .module-arrow, .module-glow { transition: none; } }
</style>
